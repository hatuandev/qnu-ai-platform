# ============================================================
# QNU MINERU 4.1.3 - API TEST
# Windows 11 | VS Code REST Client
# ============================================================

# ===== CHI CAN SUA 3 DONG NAY =====

@baseUrl = http://100.105.13.53:8000/mineru
@apiKey = sk_live_W4sdRBEQ2zzAvtgHl0H4tMYLdp305TR7
@fileBytes = 123456

# Chu y:
# - baseUrl la domain API QNU hien tai, them /mineru
# - apiKey KHONG can ghi chu Bearer
# - fileBytes la dung luong chinh xac cua test.pdf (byte)
# - Dat test.pdf cung thu muc voi file .http


### 01. HEALTH - KHONG CO API KEY
# Mong doi: HTTP 401

GET {{baseUrl}}/v1/health


### 02. HEALTH - CO API KEY
# Mong doi: HTTP 200, version 4.1.3

GET {{baseUrl}}/v1/health
Authorization: Bearer {{apiKey}}
Accept: application/json


### 03. KIEM TRA API QNU CU
# Mong doi: HTTP 200
# Kiem tra Qwen / BGE / Nemotron van hoat dong

GET {{baseUrl}}/v1/models
Authorization: Bearer {{apiKey}}
Accept: application/json


### 04. TAO TASK OCR PDF
# Mong doi: HTTP 202
# Chay request nay MOT LAN cho moi file upload.
# REST Client tu luu task_id va file_id.

# @name createTask
POST {{baseUrl}}/v1/tasks
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json

{
  "files": [
    {
      "file_name": "test.pdf",
      "bytes": {{fileBytes}}
    }
  ],
  "tier": "standard",
  "ocr_mode": "auto",
  "output_formats": ["default"]
}


### 05. UPLOAD FILE PDF
# Chay SAU request 04
# Mong doi: HTTP 200
# Dung raw binary, KHONG phai multipart/form-data.
# Dat test.pdf cung thu muc voi qnu-mineru-test.http

@taskId = {{createTask.response.body.$.task_id}}
@fileId = {{createTask.response.body.$.files[0].file_id}}

PUT {{baseUrl}}/v1/tasks/{{taskId}}/uploads/{{fileId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/octet-stream
Accept: application/json

< ./test.pdf


### 06. KIEM TRA TRANG THAI OCR
# Chay lai cho den khi status = completed
# Neu status = failed, xem chi tiet error.

# @name checkTask
GET {{baseUrl}}/v1/tasks/{{taskId}}
Authorization: Bearer {{apiKey}}
Accept: application/json


### 07. TAI KET QUA OCR
# Chi chay khi status = completed
# Ket qua mac dinh la ZIP chua Markdown, JSON, images.
# Trong VS Code REST Client, Save Response Body ra file ZIP.

GET {{baseUrl}}/v1/files/{{fileId}}/content
Authorization: Bearer {{apiKey}}
Accept: application/zip