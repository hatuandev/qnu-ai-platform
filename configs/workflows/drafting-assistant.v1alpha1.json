{
  "api_version": "qnu.ai/v1alpha1",
  "kind": "WorkflowDefinition",
  "metadata": {
    "name": "drafting-assistant",
    "display_name": "Trợ lý ảo Hỗ trợ Soạn thảo Văn bản",
    "description": "Tạo dự thảo văn bản hành chính DOCX/PDF từ yêu cầu tự nhiên; không phụ thuộc kho tri thức.",
    "scope": {
      "tenant_id": "tenant_qnu",
      "workspace_id": "workspace_research"
    },
    "module_code": "drafting",
    "labels": {
      "template": "drafting",
      "phase": "phase_1_docx_pdf"
    },
    "annotations": {
      "purpose": "document_draft_docx_pdf_without_rag"
    }
  },
  "spec": {
    "execution_mode": "conversational",
    "entry_node_id": "chat_input",
    "input_schema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "conversation_id": {
          "type": "string",
          "maxLength": 128
        },
        "document_type": {
          "type": "string",
          "default": "to_trinh"
        },
        "document_fields": {
          "type": "object",
          "description": "Thông tin hành chính đã được người dùng cung cấp rõ ràng."
        },
        "format": {
          "type": "string",
          "default": "docx,pdf"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "answer", "artifacts"],
      "properties": {
        "status": {
          "enum": ["draft_created", "draft_created_with_warnings"]
        },
        "answer": {
          "type": "string"
        },
        "artifacts": {
          "type": "array"
        },
        "missing_fields": {
          "type": "array"
        }
      }
    },
    "nodes": [
      {
        "id": "chat_input",
        "type": "input.chat",
        "version": "1.0.0",
        "display_name": "Yêu cầu soạn thảo",
        "config": {
          "trim": true,
          "max_length": 10000
        },
        "policy": {
          "timeout_seconds": 2,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      },
      {
        "id": "query_rewrite",
        "type": "query.rewrite",
        "version": "1.0.0",
        "display_name": "Giữ nguyên yêu cầu và dữ kiện",
        "config": {
          "use_fast_rules": false,
          "use_llm": false,
          "preserve_original": true
        },
        "policy": {
          "timeout_seconds": 2,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      },
      {
        "id": "extract_fields",
        "type": "extract.fields",
        "version": "1.0.0",
        "display_name": "Nhận diện loại văn bản",
        "config": {
          "preserve_user_text": true
        },
        "policy": {
          "timeout_seconds": 3,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      },
      {
        "id": "plan_draft",
        "type": "drafting.plan",
        "version": "1.0.0",
        "display_name": "Lập kế hoạch trường dữ liệu",
        "config": {
          "default_document_type": "to_trinh",
          "knowledge_required": false
        },
        "policy": {
          "timeout_seconds": 3,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": ["drafting.plan"]
        }
      },
      {
        "id": "compose_draft",
        "type": "core.drafting.compose",
        "version": "1.0.0",
        "display_name": "Soạn nội dung bản nháp",
        "config": {
          "module_code": "drafting",
          "temperature": 0.3,
          "max_tokens": 2400,
          "knowledge_required": false,
          "fabricate_missing_fields": false
        },
        "policy": {
          "timeout_seconds": 45,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": ["drafting.compose"]
        }
      },
      {
        "id": "validate_draft",
        "type": "drafting.validate",
        "version": "1.0.0",
        "display_name": "Kiểm tra bản nháp",
        "config": {
          "reject_unprovided_legal_citations": true,
          "mark_as_draft": true
        },
        "policy": {
          "timeout_seconds": 3,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      },
      {
        "id": "resolve_format",
        "type": "artifact.resolve_format",
        "version": "1.0.0",
        "display_name": "Chuẩn bị DOCX và PDF",
        "config": {
          "default_format": "docx,pdf"
        },
        "policy": {
          "timeout_seconds": 2,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      },
      {
        "id": "export_docx",
        "type": "artifact.export",
        "version": "1.0.0",
        "display_name": "Xuất tệp dự thảo",
        "config": {
          "format": "docx,pdf",
          "filename_template": "qnu-van-ban-{run_id}"
        },
        "policy": {
          "timeout_seconds": 90,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": ["artifact.write"]
        }
      },
      {
        "id": "artifact_output",
        "type": "output.artifact",
        "version": "1.0.0",
        "display_name": "Trả bản nháp và tệp tải xuống",
        "config": {
          "include_preview": true,
          "download_requires_auth": true
        },
        "policy": {
          "timeout_seconds": 2,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      }
    ],
    "edges": [
      {
        "id": "edge_input_to_rewrite",
        "source": {"node_id": "chat_input", "port": "message"},
        "target": {"node_id": "query_rewrite", "port": "message"},
        "priority": 100
      },
      {
        "id": "edge_rewrite_to_extract",
        "source": {"node_id": "query_rewrite", "port": "normalized_query"},
        "target": {"node_id": "extract_fields", "port": "text"},
        "priority": 100
      },
      {
        "id": "edge_extract_to_plan",
        "source": {"node_id": "extract_fields", "port": "fields"},
        "target": {"node_id": "plan_draft", "port": "fields"},
        "priority": 100
      },
      {
        "id": "edge_plan_to_compose",
        "source": {"node_id": "plan_draft", "port": "plan"},
        "target": {"node_id": "compose_draft", "port": "plan"},
        "priority": 100
      },
      {
        "id": "edge_compose_to_validate",
        "source": {"node_id": "compose_draft", "port": "draft"},
        "target": {"node_id": "validate_draft", "port": "draft"},
        "priority": 100
      },
      {
        "id": "edge_validate_to_format",
        "source": {"node_id": "validate_draft", "port": "draft"},
        "target": {"node_id": "resolve_format", "port": "draft"},
        "priority": 100
      },
      {
        "id": "edge_validate_to_export",
        "source": {"node_id": "validate_draft", "port": "draft"},
        "target": {"node_id": "export_docx", "port": "draft"},
        "priority": 100
      },
      {
        "id": "edge_format_to_export",
        "source": {"node_id": "resolve_format", "port": "formats"},
        "target": {"node_id": "export_docx", "port": "formats"},
        "priority": 100
      },
      {
        "id": "edge_export_to_output",
        "source": {"node_id": "export_docx", "port": "artifacts"},
        "target": {"node_id": "artifact_output", "port": "artifacts"},
        "priority": 100
      }
    ],
    "policies": {
      "run_timeout_seconds": 180,
      "max_steps": 12,
      "max_parallel_nodes": 1,
      "default_retry": {
        "max_attempts": 1,
        "initial_backoff_ms": 250,
        "max_backoff_ms": 2000,
        "retryable_error_codes": []
      },
      "data_classification": "internal",
      "allowed_connection_ids": ["conn_qnu_ai_core", "conn_qnu_artifact_store"],
      "quality_gate_id": "gate_drafting_baseline"
    },
    "compatibility": {
      "min_runtime_version": "0.1.0",
      "node_resolution": "exact",
      "features": ["structured_drafting", "docx", "pdf", "optional_knowledge"]
    }
  }
}
