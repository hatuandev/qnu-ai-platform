{
  "api_version": "qnu.ai/v1alpha1",
  "kind": "WorkflowDefinition",
  "metadata": {
    "name": "drafting-assistant",
    "display_name": "Trợ lý Soạn thảo QNU",
    "description": "Vertical slice kiểm chứng clarification, retrieval mẫu NĐ30, approval và artifact trên cùng Workflow Runtime.",
    "scope": {
      "tenant_id": "tenant_qnu",
      "workspace_id": "workspace_research"
    },
    "module_code": "drafting",
    "labels": {
      "template": "drafting",
      "phase": "phase_1_vertical_slice"
    },
    "annotations": {
      "purpose": "phase_0_contract_example"
    }
  },
  "spec": {
    "execution_mode": "conversational",
    "entry_node_id": "chat_input",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "conversation_id": {
          "type": "string",
          "maxLength": 128
        },
        "document_type": {
          "type": "string",
          "default": "cong_van"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["needs_clarification", "pending_approval", "approved", "rejected", "exported"]
        },
        "message": {
          "type": "string"
        },
        "artifact": {
          "type": "object"
        }
      }
    },
    "nodes": [
      {
        "id": "chat_input",
        "type": "input.chat",
        "version": "1.0.0",
        "display_name": "Yêu cầu soạn thảo",
        "config": {
          "trim": true,
          "max_length": 10000
        },
        "policy": {
          "timeout_seconds": 2,
          "max_attempts": 1,
          "checkpoint_after": true,
          "required_permissions": []
        }
      },
      {
        "id": "query_rewrite",
        "type": "query.rewrite",
        "version": "1.0.0",
        "display_name": "Chuẩn hóa yêu cầu soạn thảo văn bản",
        "config": {
          "use_fast_rules": true,
          "use_llm": true,
          "preserve_original": true,
          "instruction": "Bạn là trợ lý chuẩn hóa yêu cầu soạn thảo văn bản hành chính theo Nghị định 30 cho Trường Đại học Quy Nhơn (QNU).\nNhiệm vụ: Sửa các từ gõ nhầm trượt phím Telex hoặc nhầm lẫn ngữ cảnh (ví dụ: 'tờ trinh' -> 'tờ trình', 'kế hoach' -> 'kế hoạch', 'quyết đinh' -> 'quyết định', 'công văn' -> 'công văn hành chính', 'nghị định 30' -> 'Nghị định 30/2020/NĐ-CP'), mở rộng các từ viết tắt cơ quan/đơn vị (BGH, ĐHQG, UBND, PĐT, TCHC, CTSV) và chuẩn hóa tên loại văn bản hành chính."
        },
        "policy": {
          "timeout_seconds": 5,
          "max_attempts": 1,
          "checkpoint_after": false,
          "required_permissions": []
        }
      },
      {
        "id": "extract_fields",
        "type": "extract.fields",
        "version": "1.0.0",
        "display_name": "Trích xuất trường văn bản",
        "config": {
          "preserve_user_text": true
        },
        "connection_refs": ["conn_qnu_ai_core"],
        "policy": {
          "timeout_seconds": 20,
          "max_attempts": 2,
          "checkpoint_after": true,
          "required_permissions": ["drafting.plan"]
        }
      },
      {
        "id": "clarify_missing_fields",
        "type": "interaction.clarify",
        "version": "1.0.0",
        "display_name": "Hỏi thông tin còn thiếu",
        "config": {
          "max_rounds": 4,
          "wait_timeout_seconds": 86400,
          "pass_through_when_complete": true
        },
        "policy": {
          "timeout_seconds": 5,
          "max_attempts": 1,
          "checkpoint_after": true,
          "required_permissions": ["run.resume"]
        }
      },
      {
        "id": "sample_retrieval",
        "type": "core.knowledge.answer",
        "version": "1.0.0",
        "display_name": "Tra cứu Mẫu Văn bản NĐ30",
        "config": {
          "module_code": "drafting",
          "collection_id": "col_drafting",
          "profile": "rag_fast",
          "require_citations": false,
          "retrieval_limit": 3,
          "context_max_chars": 12000
        },
        "connection_refs": ["conn_qnu_ai_core"],
        "policy": {
          "timeout_seconds": 15,
          "max_attempts": 2,
          "checkpoint_after": true,
          "required_permissions": ["core.rag"]
        }
      },
      {
        "id": "compose_draft",
        "type": "core.drafting.compose",
        "version": "1.0.0",
        "display_name": "Tạo bản nháp",
        "config": {
          "module_code": "drafting",
          "document_type": "auto",
          "template_code": "qnu_cong_van",
          "output_format": "markdown",
          "fabricate_missing_fields": false
        },
        "connection_refs": ["conn_qnu_ai_core"],
        "policy": {
          "timeout_seconds": 30,
          "max_attempts": 2,
          "checkpoint_after": true,
          "required_permissions": ["drafting.compose"]
        }
      },
      {
        "id": "approve_draft",
        "type": "human.approval",
        "version": "1.0.0",
        "display_name": "Phê duyệt bản nháp",
        "config": {
          "required_permission": "approval.decide",
          "separation_of_duties": true,
          "reason_required_on_reject": true,
          "wait_timeout_seconds": 172800
        },
        "policy": {
          "timeout_seconds": 5,
          "max_attempts": 1,
          "checkpoint_after": true,
          "required_permissions": ["approval.decide"]
        }
      },
      {
        "id": "clarify_format",
        "type": "interaction.clarify",
        "version": "1.0.0",
        "display_name": "Chọn định dạng xuất văn bản",
        "config": {
          "max_rounds": 2,
          "wait_timeout_seconds": 86400,
          "pass_through_when_complete": true,
          "required_fields": ["format"],
          "defaults": {
            "format": "docx"
          }
        },
        "policy": {
          "timeout_seconds": 5,
          "max_attempts": 1,
          "checkpoint_after": true,
          "required_permissions": ["run.resume"]
        }
      },
      {
        "id": "export_docx",
        "type": "artifact.export",
        "version": "1.0.0",
        "display_name": "Xuất Tệp Văn bản",
        "config": {
          "format": "docx,pdf",
          "filename_template": "qnu-van-ban-{run_id}.docx",
          "content_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "connection_refs": ["conn_qnu_artifact_store"],
        "policy": {
          "timeout_seconds": 30,
          "max_attempts": 2,
          "checkpoint_after": true,
          "required_permissions": ["artifact.write"]
        }
      },
      {
        "id": "artifact_output",
        "type": "output.artifact",
        "version": "1.0.0",
        "display_name": "Trả kết quả văn bản",
        "config": {
          "include_preview": true,
          "download_requires_auth": true
        },
        "policy": {
          "timeout_seconds": 2,
          "max_attempts": 1,
          "checkpoint_after": true,
          "required_permissions": []
        }
      }
    ],
    "edges": [
      {
        "id": "edge_input_to_rewrite",
        "source": {
          "node_id": "chat_input",
          "port": "message"
        },
        "target": {
          "node_id": "query_rewrite",
          "port": "message"
        },
        "priority": 100
      },
      {
        "id": "edge_rewrite_to_extract",
        "source": {
          "node_id": "query_rewrite",
          "port": "normalized_query"
        },
        "target": {
          "node_id": "extract_fields",
          "port": "text"
        },
        "priority": 100
      },
      {
        "id": "edge_extract_to_clarify",
        "source": {
          "node_id": "extract_fields",
          "port": "fields"
        },
        "target": {
          "node_id": "clarify_missing_fields",
          "port": "fields"
        },
        "priority": 100
      },
      {
        "id": "edge_rewrite_to_samples",
        "source": {
          "node_id": "query_rewrite",
          "port": "normalized_query"
        },
        "target": {
          "node_id": "sample_retrieval",
          "port": "question"
        },
        "priority": 100
      },
      {
        "id": "edge_clarify_to_compose",
        "source": {
          "node_id": "clarify_missing_fields",
          "port": "complete_fields"
        },
        "target": {
          "node_id": "compose_draft",
          "port": "fields"
        },
        "priority": 100
      },
      {
        "id": "edge_samples_to_compose",
        "source": {
          "node_id": "sample_retrieval",
          "port": "context"
        },
        "target": {
          "node_id": "compose_draft",
          "port": "samples"
        },
        "priority": 100
      },
      {
        "id": "edge_compose_to_approval",
        "source": {
          "node_id": "compose_draft",
          "port": "draft"
        },
        "target": {
          "node_id": "approve_draft",
          "port": "subject"
        },
        "priority": 100
      },
      {
        "id": "edge_approval_to_clarify_format",
        "source": {
          "node_id": "approve_draft",
          "port": "approved"
        },
        "target": {
          "node_id": "clarify_format",
          "port": "fields"
        },
        "priority": 100
      },
      {
        "id": "edge_clarify_format_to_export",
        "source": {
          "node_id": "clarify_format",
          "port": "complete_fields"
        },
        "target": {
          "node_id": "export_docx",
          "port": "content"
        },
        "priority": 100
      },
      {
        "id": "edge_clarify_format_option_to_export",
        "source": {
          "node_id": "clarify_format",
          "port": "format"
        },
        "target": {
          "node_id": "export_docx",
          "port": "format"
        },
        "priority": 90
      },
      {
        "id": "edge_export_to_output",
        "source": {
          "node_id": "export_docx",
          "port": "artifact"
        },
        "target": {
          "node_id": "artifact_output",
          "port": "artifact"
        },
        "priority": 100
      }
    ],
    "policies": {
      "run_timeout_seconds": 259200,
      "max_steps": 24,
      "max_parallel_nodes": 1,
      "default_retry": {
        "max_attempts": 1,
        "initial_backoff_ms": 250,
        "max_backoff_ms": 2000,
        "retryable_error_codes": []
      },
      "data_classification": "internal",
      "allowed_connection_ids": ["conn_qnu_ai_core", "conn_qnu_artifact_store"],
      "quality_gate_id": "gate_drafting_baseline"
    },
    "compatibility": {
      "min_runtime_version": "0.1.0",
      "node_resolution": "exact",
      "features": ["clarification", "approval", "artifact"]
    }
  }
}
