{
  "api_version": "qnu.ai/v1alpha1",
  "kind": "NodeManifest",
  "metadata": {
    "type": "output.artifact",
    "version": "1.0.0",
    "display_name": "Phản hồi Tệp Đính kèm",
    "description": "Trả về thông tin tệp tài liệu được tạo ra cùng đường dẫn tải xuống trực tiếp cho người dùng.",
    "category": "output",
    "labels": {
      "format": "artifact"
    }
  },
  "spec": {
    "handler": {
      "kind": "builtin",
      "operation": "output.artifact"
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_preview": {
          "type": "boolean",
          "default": true
        },
        "download_requires_auth": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact"],
      "properties": {
        "artifact": {
          "type": "object"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object"
        }
      }
    },
    "capabilities": ["artifact.read"],
    "required_permissions": [],
    "connection_types": [],
    "execution": {
      "default_timeout_seconds": 2,
      "max_timeout_seconds": 10,
      "default_max_attempts": 1,
      "side_effects": "none",
      "idempotency": "not_required",
      "checkpoint": "never",
      "can_wait_for_input": false,
      "can_wait_for_approval": false
    },
    "observability": {
      "safe_trace_fields": ["status", "artifact_id"],
      "redacted_fields": []
    },
    "compatibility": {
      "min_runtime_version": "0.1.0",
      "status": "experimental"
    }
  }
}


