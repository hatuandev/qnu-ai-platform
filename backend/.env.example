# ==============================================================================
# QNU.AI Platform — Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
SERVICE_NAME=qnu-ai-platform
API_PREFIX=/platform/v1alpha1
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8001"]

# --- QNU SSO Integration (OpenIddict) ---
SSO_ENABLED=true
SSO_AUTHORITY=https://sso.qnu.edu.vn
SSO_CLIENT_ID=qnu-ai-platform
SSO_AUDIENCE=ai.api
DEV_AUTH_ENABLED=false

# --- PostgreSQL 16 ---
POSTGRES_USER=qnu
POSTGRES_PASSWORD=qnu_password_secure_2026
POSTGRES_DB=qnu_ai_platform
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://qnu:qnu_password_secure_2026@127.0.0.1:5432/qnu_ai_platform

# --- Qdrant Vector DB ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qnu_knowledge_chunks
VECTOR_SIZE=1024

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- MinIO S3 ---
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=qnu_minio_admin
S3_SECRET_KEY=qnu_minio_secret_2026
S3_BUCKET=qnu-ai-documents
S3_SECURE=false

# --- Gotenberg ---
GOTENBERG_URL=http://127.0.0.1:3005

# --- Embeddings & Reranker ---
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-m3
RERANKER_PROVIDER=cloudflare
RERANKER_MODEL=@cf/baai/bge-reranker-base
DEFAULT_TOP_K=8
DEFAULT_RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=6000

# --- Security & Keys ---
SECRET_KEY=change-in-production-super-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_API_KEY=qnu_internal_secret_key_2026
PROVIDER_ENCRYPTION_KEY=qnu_provider_encryption_key_32bytes_sec!

# --- Dev Access Gate (Only for development/test) ---
DEV_ACCESS_PASSWORD=QNU@2026
DEV_AUTO_MIGRATE=true
DEV_AUTO_SEED=true
RATE_LIMIT_PER_MINUTE=120

LOG_LEVEL=INFO
JSON_LOGGING=false
ENABLE_PROMETHEUS=true
