# QNU backend v1 - safe defaults only, never real secrets
ENVIRONMENT=development
SERVICE_NAME=qnu-backend-v1
API_PREFIX=/platform/v1alpha1
HOST=0.0.0.0
PORT=8002
PUBLIC_BASE_URL=http://localhost:8002

DATABASE_URL=postgresql+asyncpg://qnu:change_me@localhost:5432/qnu_ai_platform
REDIS_URL=redis://localhost:6379/3
QUEUE_NAME=qnu:v1:jobs
CACHE_NAMESPACE=qnu:v1:cache:

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=qnu-ai-documents
S3_SECURE=false

QDRANT_URL=http://localhost:6333

SECRET_KEY=replace_with_random_signing_key_at_least_32_bytes
INTERNAL_API_KEY=
PROVIDER_ENCRYPTION_KEY=
DEV_AUTH_ENABLED=true
DEV_ACCESS_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# QNU SSO OpenID Connect verification (RS256, audience ai.api)
# In production, DEV_AUTH_ENABLED must be false and SSO_ENABLED must be true.
SSO_ENABLED=false
SSO_AUTHORITY=https://sso.qnu.edu.vn
SSO_AUDIENCE=ai.api
SSO_JWKS_URL=https://sso.qnu.edu.vn/.well-known/openid-configuration/jwks
SSO_JWKS_CACHE_SECONDS=300

# OCR processing (Context640). Provider endpoint/model/credential come from the
# ModelOps database, never from this file.
# Document conversion service (infrastructure, not an AI provider).
GOTENBERG_URL=http://127.0.0.1:3005
DOCX_CONVERTER=gotenberg-libreoffice
# Bump when converter image/fonts/options change; this is a deployment revision.
DOCX_RENDERER_REVISION=qnu-docx/v2
OCR_RENDER_DPI=144
OCR_MAX_PAGES=300
OCR_MAX_PAGE_BYTES=8388608
# Optional legacy image OCR override; omit for ModelOps automatic output budgeting.
# OCR_MAX_OUTPUT_TOKENS=8192
OCR_PAGE_TOKEN_BUDGET=8192
OCR_RUN_MAX_ATTEMPTS=2
OCR_LEASE_SECONDS=900
OCR_DISPATCH_ENABLED=true
OWN_RECONCILE=true
# Wall-clock ceiling for OCR/compiler/review/index jobs; provider waits and leases are separate.
WORKER_MODEL_JOB_TIMEOUT_SECONDS=86400
