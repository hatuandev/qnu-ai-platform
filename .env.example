# Local QNU V1 template. Existing installations: keep .env, keys and storage targets.
ENVIRONMENT=development
SERVICE_NAME=qnu-backend-v1
API_PREFIX=/platform/v1alpha1
PORT=8002
PUBLIC_BASE_URL=http://localhost:8002
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Local infrastructure template; replace credentials before use.
POSTGRES_USER=qnu
POSTGRES_PASSWORD=replace_local_postgres_password
POSTGRES_DB=qnu_ai_platform
DATABASE_URL=postgresql+asyncpg://qnu:replace_local_postgres_password@localhost:5432/qnu_ai_platform
REDIS_URL=redis://localhost:6379/3
QUEUE_NAME=qnu:v1:jobs
CACHE_NAMESPACE=qnu:v1:cache:
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qnu_knowledge_chunks
VECTOR_SIZE=1024
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace_local_minio_user
S3_SECRET_KEY=replace_local_minio_password
S3_BUCKET=qnu-ai-documents
S3_SECURE=false
GOTENBERG_URL=http://localhost:3005
DOCX_CONVERTER=gotenberg-libreoffice
DOCX_RENDERER_REVISION=qnu-docx/v2
SECRET_KEY=replace_with_random_signing_key_at_least_32_bytes
PROVIDER_ENCRYPTION_KEY=replace_with_private_modelops_encryption_key
INTERNAL_API_KEY=
DEV_AUTH_ENABLED=true
DEV_ACCESS_PASSWORD=
SSO_ENABLED=false
SSO_AUTHORITY=http://localhost:5000
SSO_AUDIENCE=ai.api
SSO_JWKS_URL=
LOG_LEVEL=INFO
OWN_RECONCILE=true
WORKER_MODEL_JOB_TIMEOUT_SECONDS=86400
COMPILER_MAX_OUTPUT_TOKENS=8192
COMPILER_SEGMENT_CONCURRENCY=2
# Providers/models/OCR and their API keys come from protected ModelOps DB.
# Optional E2E bootstrap only; never exported to application runtime or reports.
E2E_QNU_API_KEY=
E2E_9ROUTER_API_KEY=
