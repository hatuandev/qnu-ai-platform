# ==============================================================================
# QNU.AI Platform — Environment Configuration Template
# ==============================================================================

# --- Môi trường & API Server ---
ENVIRONMENT=development
SERVICE_NAME=qnu-ai-platform
API_PREFIX=/platform/v1alpha1
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8001"]

# --- Cơ sở Dữ liệu PostgreSQL 16 (Quan hệ + FTS tiếng Việt) ---
POSTGRES_USER=qnu
POSTGRES_PASSWORD=qnu_password
POSTGRES_DB=qnu_ai_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://qnu:qnu_password@localhost:5432/qnu_ai_platform

# --- Cơ sở Dữ liệu Vector Qdrant (BGE-M3 1024 chiều) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qnu_knowledge_chunks
VECTOR_SIZE=1024

# --- Redis Cache & Async Job Broker ---
REDIS_URL=redis://localhost:6379/0

# --- Tầng Lưu trữ Tệp Đối Tượng (Object Storage MinIO / S3) ---
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./storage

# Cấu hình MinIO / S3 (Lưu trữ toàn bộ tài liệu gốc và tệp xuất ra)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=qnu
S3_SECRET_KEY=qnu_password
S3_BUCKET=qnu-ai-documents
S3_SECURE=false

# --- Dịch vụ Chuyển đổi Tài liệu PDF Gotenberg 8 (Nghị định 30) ---
GOTENBERG_URL=http://localhost:3005

# --- Mô hình Embedding & Tái xếp hạng (Reranker) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEFAULT_TOP_K=8
DEFAULT_RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=6000

# --- Nhà Cung cấp LLM (OpenAI, Gemini, Local vLLM/Ollama) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# Google Gemini (Tùy chọn)
GEMINI_API_KEY=

# Local LLM endpoint (vLLM / Ollama chạy nội bộ cho dữ liệu mật)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

# --- Bảo mật & Xác thực ---
SECRET_KEY=qnu-ai-platform-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_API_KEY=qnu_internal_secret_key_2026
DEV_AUTH_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Giám sát & Logs ---
LOG_LEVEL=INFO
JSON_LOGGING=true
ENABLE_PROMETHEUS=true
