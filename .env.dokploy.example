# ==============================================================================
# QNU.AI Platform — Dokploy Production Environment Variables (.env)
# Hướng dẫn: Copy toàn bộ nội dung file này dán vào tab Environment của Dokploy.
# Bạn chỉ cần thay thế các thông số kết nối Database, Redis, MinIO, Qdrant đã có sẵn trên Dokploy.
# ==============================================================================

# --- Môi trường ---
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["https://qnu-ai.duckdns.org"]

# --- 1. PostgreSQL (Dokploy PostgreSQL Service / Server CSDL) ---
# Cách A: Dùng nguyên vẹn chuỗi CONNECTION_STRING của bạn (Hệ thống tự động chuyển đổi sang asyncpg):
# CONNECTION_STRING=Host=222.255.137.82;Port=5432;Database=qnu_ai_platform;Username=admin;Password=MatKhau;Ssl Mode=Disable
#
# Hoặc Cách B (Chuẩn SQLAlchemy asyncpg URL):
DATABASE_URL=postgresql+asyncpg://admin:MatKhauPostgres@postgres-internal-host:5432/qnu_ai_platform

# Bootstrap tự chạy migration + seed thông minh mỗi lần Deploy.
# Các giá trị dưới đây là tùy chọn; chỉ tăng nếu hạ tầng khởi động chậm.
BOOTSTRAP_MAX_ATTEMPTS=12
BOOTSTRAP_RETRY_SECONDS=5
BOOTSTRAP_SEED_ATTEMPTS=3

# --- 2. Redis (Dokploy Redis Service) ---
# Sử dụng Internal Connection URL từ Dokploy:
REDIS_URL=redis://default:MatKhauRedis@db-qnuredis-trnpci:6379/0

# --- 3. Qdrant Vector Database (Dokploy Qdrant Service) ---
QDRANT_URL=http://qnu-qdrant:6333
# Để trống nếu Qdrant không bật API key; nếu đã bật phải nhập đúng cùng một giá trị.
QDRANT_API_KEY=
QDRANT_COLLECTION=qnu_knowledge_chunks

# --- 4. MinIO S3 Object Storage (Dokploy MinIO Service) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio-internal-host:9000
S3_ACCESS_KEY=TaiKhoanMinIO
S3_SECRET_KEY=MatKhauMinIO
S3_BUCKET=qnu-ai-documents
S3_SECURE=false


# --- 5. Gotenberg 8 PDF Converter (Dokploy Gotenberg Service) ---
GOTENBERG_URL=http://gotenberg-internal-host:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# --- 6. Nhà Cung Cấp Mô Hình LLM ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# Google Gemini (Tùy chọn)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# Embedding và Reranker được chọn trong ModelOps; credential được lưu tại Provider.
# Không khai báo CLOUDFLARE_ACCOUNT_ID hoặc CLOUDFLARE_API_TOKEN tại Dokploy.

# --- 7. Bảo Mật & Xác Thực (Đã sinh ngẫu nhiên an toàn) ---
SECRET_KEY=ThayBangChuoiNgauNhienToiThieu64KyTu
PROVIDER_ENCRYPTION_KEY=ThayBangChuoiNgauNhienRiengToiThieu32KyTu
INTERNAL_API_KEY=ThayBangChuoiNgauNhienKhacToiThieu64KyTu
DEV_AUTH_ENABLED=true
DEV_ACCESS_PASSWORD=ThayBangMatKhauQuanTriManh

# --- 8. QNU Single Sign-On (OIDC / OpenIddict) & Phân quyền RBAC ---
SSO_ENABLED=true
SSO_AUTHORITY=https://sso.qnu.edu.vn
SSO_CLIENT_ID=qnu-ai-platform
SSO_AUDIENCE=ai.api
