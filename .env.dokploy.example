# ==============================================================================
# QNU.AI Platform — Dokploy Production Environment Variables (.env)
# Hướng dẫn: Copy toàn bộ nội dung file này dán vào tab Environment của Dokploy.
# Điền kết nối hạ tầng có sẵn và cấu hình SSO thật trước Deploy.
# Khi nâng cấp: GIỮ khóa mã hóa/provider và đích lưu trữ hiện tại, không reset DB.
# Đây là placeholder, không phải khóa đã sinh hay credential có thể sử dụng.
# ==============================================================================

# --- Môi trường ---
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["https://qnu-ai.duckdns.org"]
APP_IMAGE_TAG=demo-20261015
BACKEND_WORKERS=4

# --- 1. PostgreSQL (Dokploy PostgreSQL Service / Server CSDL) ---
# Compose yêu cầu DATABASE_URL; mật khẩu có ký tự đặc biệt phải URL-encode.
DATABASE_URL=postgresql+asyncpg://admin:MatKhauPostgres@postgres-internal-host:5432/qnu_ai_platform

# Bootstrap tự chạy migration + seed thông minh mỗi lần Deploy.
# Các giá trị dưới đây là tùy chọn; chỉ tăng nếu hạ tầng khởi động chậm.
# AUTO_SEED=false của bản cũ không vô hiệu hóa bootstrap hiện tại.
BOOTSTRAP_MAX_ATTEMPTS=12
BOOTSTRAP_RETRY_SECONDS=5
BOOTSTRAP_SEED_ATTEMPTS=3

# --- 2. Redis (Dokploy Redis Service) ---
# Sử dụng Internal Connection URL từ Dokploy:
REDIS_URL=redis://default:MatKhauRedis@db-qnuredis-trnpci:6379/0

# --- 3. Qdrant Vector Database (Dokploy Qdrant Service) ---
QDRANT_URL=http://qnu-qdrant:6333
# Để trống nếu Qdrant không bật API key; nếu đã bật phải nhập đúng cùng một giá trị.
QDRANT_API_KEY=
QDRANT_COLLECTION=qnu_knowledge_chunks

# --- 4. MinIO S3 Object Storage (Dokploy MinIO Service) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio-internal-host:9000
S3_ACCESS_KEY=TaiKhoanMinIO
S3_SECRET_KEY=MatKhauMinIO
S3_BUCKET=qnu-ai-documents
S3_SECURE=false


# --- 5. Gotenberg 8 PDF Converter (Dokploy Gotenberg Service) ---
GOTENBERG_URL=http://gotenberg-internal-host:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# --- 6. ModelOps chỉ quản lý qua Database ---
# Chat, OCR, embedding, reranker và API key được cấu hình trong /models.
# Không khai báo API key/model LLM tại Dokploy Environment.
# localhost:20128 trong container KHÔNG phải máy cá nhân chạy 9router.
# Đổi base URL của provider qua UI sau khi xác nhận tuyến mạng riêng từ server.

# --- 7. Bảo Mật & Xác Thực ---
# Bản đang chạy: giữ các khóa hiện tại; không dán placeholder này đè lên khóa thật.
# Bản mới: sinh khóa riêng trong kho bí mật, không commit hoặc gửi qua chat/log.
SECRET_KEY=ThayBangChuoiNgauNhienToiThieu64KyTu
PROVIDER_ENCRYPTION_KEY=ThayBangChuoiNgauNhienRiengToiThieu32KyTu
INTERNAL_API_KEY=ThayBangChuoiNgauNhienKhacToiThieu64KyTu
DEV_AUTH_ENABLED=false
# Chỉ bật cả hai cờ khi chủ động dùng mật khẩu Dev trên server demo HTTPS.
DEV_AUTH_ALLOW_IN_PRODUCTION=false
DEV_ACCESS_PASSWORD=
# Chỉ đặt khi thực hiện quy trình rotation đã xác nhận; mặc định không dùng khóa cũ.
OLD_PROVIDER_ENCRYPTION_KEYS=[]

# --- 8. QNU Single Sign-On (OIDC / OpenIddict) & Phân quyền RBAC ---
SSO_ENABLED=true
SSO_AUTHORITY=https://sso.qnu.edu.vn
SSO_CLIENT_ID=qnu-ai-platform
SSO_AUDIENCE=ai.api
# Các giá trị VITE là PUBLIC, được đưa vào bundle ở bước build, không chứa secret.
# Đăng ký redirect URI đầy đủ (origin của demo + path bên dưới) tại SSO.
VITE_SSO_REDIRECT_URI=/signin-oidc
VITE_SSO_POST_LOGOUT_REDIRECT_URI=/sign-in
VITE_SSO_SCOPE=openid profile email roles offline_access ai.api
# Demo chưa có SSO: DEV_AUTH_ENABLED=true, DEV_AUTH_ALLOW_IN_PRODUCTION=true,
# SSO_ENABLED=false, DEV_ACCESS_PASSWORD riêng ngẫu nhiên 24–128 ký tự.
# ALLOWED_ORIGINS phải là origin HTTPS chính xác; SECRET_KEY >= 32 ký tự.
# Giữ ENVIRONMENT=production. Không dùng mật khẩu mặc định/đã lộ trong ảnh.
# Redis phải hoạt động: đăng nhập sẽ trả 503 nếu không kiểm tra được tần suất.
