# QNU V1 on Dokploy. Placeholders only; do not replace existing live keys/data URLs.
ENVIRONMENT=production
APP_IMAGE_TAG=v1.0.3
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://qnu-ai.example.edu.vn
# V1 reads comma-separated origins, not a JSON array.
ALLOWED_ORIGINS=https://qnu-ai.example.edu.vn
# Container-accessible services; localhost here refers to the container itself.
DATABASE_URL=postgresql+asyncpg://qnu:replace_me@postgres-internal:5432/qnu_ai_platform
REDIS_URL=redis://redis-internal:6379/3
V1_QUEUE_NAME=qnu:v1:jobs
V1_CACHE_NAMESPACE=qnu:v1:cache:
QDRANT_URL=http://qdrant-internal:6333
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio-internal:9000
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_BUCKET=qnu-ai-documents
# storage-init creates the bucket when missing; the key needs HeadBucket/CreateBucket.
S3_SECURE=false
GOTENBERG_URL=http://gotenberg-internal:3000
DOCX_CONVERTER=gotenberg-libreoffice
DOCX_RENDERER_REVISION=qnu-docx/v2
# Keep existing values when upgrading; never rotate these as part of a code deploy.
SECRET_KEY=replace_with_random_signing_key
PROVIDER_ENCRYPTION_KEY=keep_existing_modelops_encryption_key
INTERNAL_API_KEY=
# Production V1 does not allow dev login, including old legacy demo flags.
DEV_AUTH_ENABLED=false
SSO_ENABLED=true
# Exact discovery issuer (trailing slash included) and JWKS from
# https://sso.qnu.edu.vn/.well-known/openid-configuration.
SSO_AUTHORITY=https://sso.qnu.edu.vn/
SSO_AUDIENCE=ai_api
SSO_JWKS_URL=https://sso.qnu.edu.vn/.well-known/jwks
# ModelOps resolves output budgets automatically; these only limit concurrency.
COMPILER_SEGMENT_CONCURRENCY=2
MODEL_CHAT_CONCURRENCY=4
OCR_MAX_PAGES=300
MAX_UPLOAD_BYTES=62914560
WORKER_MODEL_JOB_TIMEOUT_SECONDS=86400
# Exactly one backend replica reconciles the queue; set false on additional replicas.
OWN_RECONCILE=true
# Keep exact answer reuse off until callers are rate limited.
ANSWER_CACHE_TTL_SECONDS=0
# System kill-switch for every published chatbot page; false answers 404 on
# /public/chatbots/* until the backend is restarted with it back on.
PUBLIC_CHATBOTS_ENABLED=true
# Set FORWARDED_ALLOW_IPS to the actual Traefik/nginx IPs or a subnet dedicated to those proxies.
# Until configured, per-IP limits behind a remote proxy use the proxy address.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Bootstrap runs alembic upgrade head for V1 only; there is no automatic seed/reset.
# Configure providers (including MinerU), keys and system model defaults in ModelOps.
