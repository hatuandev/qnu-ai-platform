# ==============================================================================
# QNU.AI Platform — Dokploy Production Environment Variables (.env)
# Hướng dẫn: Copy toàn bộ nội dung file này dán vào tab Environment của Dokploy.
# Bạn chỉ cần thay thế các thông số kết nối Database, Redis, MinIO, Qdrant đã có sẵn trên Dokploy.
# ==============================================================================

# --- Môi trường ---
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["*"]

# --- 1. PostgreSQL (Dokploy PostgreSQL Service) ---
# Gợi ý: Nếu dùng Dokploy Postgres nội bộ, host thường là tên container hoặc IP nội bộ
# Ví dụ: postgresql+asyncpg://postgres:MatKhauCuaBan@dokploy-postgres:5432/qnu_ai_platform
DATABASE_URL=postgresql+asyncpg://qnu:qnu_password_secure_2026@postgres:5432/qnu_ai_platform
AUTO_SEED=true

# --- 2. Redis (Dokploy Redis Service) ---
REDIS_URL=redis://redis:6379/0

# --- 3. Qdrant Vector Database (Dokploy Qdrant Service) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qnu_knowledge_chunks

# --- 4. MinIO S3 Object Storage (Dokploy MinIO Service) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=qnu_minio_admin
S3_SECRET_KEY=qnu_minio_secret_2026
S3_BUCKET=qnu-ai-documents
S3_SECURE=false

# --- 5. Gotenberg 8 PDF Converter (Dokploy Gotenberg Service) ---
# Cổng mặc định nội bộ của Gotenberg là 3000
GOTENBERG_URL=http://gotenberg:3000

# --- 6. Nhà Cung Cấp Mô Hình LLM ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# Google Gemini (Tùy chọn)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# Cloudflare Workers AI Embedding / Reranker (Tùy chọn)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- 7. Bảo Mật & Xác Thực (Đã sinh ngẫu nhiên an toàn) ---
SECRET_KEY=8f4a1c6e9d2b7f3a5e8c1b4d7f0a3c6e9b2d5f8a1c4e7b0d3f6a9c2e5b8d1f4a
INTERNAL_API_KEY=qnu_internal_secure_token_prod_2026
DEV_AUTH_ENABLED=false
