# Development server only. These values contain no credentials.
FRONTEND_PORT=3001

# Where the Vite dev/preview server forwards /platform/v1alpha1.
# backendV1 defaults to 127.0.0.1:8002 (see backendV1/.env.example PORT).
QNU_API_PROXY_TARGET=http://127.0.0.1:8002

# Optional. Leave empty to call the API on the same origin through the proxy
# above. Set an absolute origin only when the API is served from another host.
# Never put a password, access key or LLM key in a VITE_* variable: everything
# with this prefix is inlined into the browser bundle.
VITE_QNU_API_BASE_URL=

# QNU SSO Single Sign-On (OpenIddict PKCE S256, Public SPA client)
# Authority: http://localhost:5000 in local dev, https://sso.qnu.edu.vn in production
VITE_SSO_AUTHORITY=http://localhost:5000
VITE_SSO_CLIENT_ID=qnu-ai-platform
VITE_SSO_REDIRECT_URI=http://localhost:3001/signin-oidc
VITE_SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/sign-in
VITE_SSO_SCOPE=openid profile email roles offline_access ai.api

# Set to false in production to disable dev access key input completely
VITE_DEV_AUTH_ENABLED=true

# --- Tự đăng nhập khi phát triển local (tùy chọn, mặc định TẮT) --------------
# Chỉ có hiệu lực trong Vite dev server; không tồn tại trong build/preview.
# Khai báo trong frontendV1/.env.local (đã bị .gitignore), KHÔNG khai báo ở đây
# và KHÔNG dùng tiền tố VITE_ cho access key.
#
# QNU_DEV_AUTO_LOGIN=true
# QNU_DEV_ACCESS_KEY=<cùng giá trị với DEV_ACCESS_PASSWORD của backendV1>
#
# Yêu cầu phía backendV1: DEV_AUTH_ENABLED=true, DEV_ACCESS_PASSWORD trùng
# QNU_DEV_ACCESS_KEY, SECRET_KEY tối thiểu 32 byte, ENVIRONMENT khác production.
# Cầu nối chỉ nhận request loopback cùng origin và chỉ gọi backend loopback.

