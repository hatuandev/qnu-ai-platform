# Development server port
FRONTEND_V2_PORT=3002

# Where Vite dev forwards /platform/v1alpha1 (backendV1 default port 8002)
QNU_API_PROXY_TARGET=http://127.0.0.1:8002

# --- Tự đăng nhập khi phát triển local (Dev Auto-Login) ---
# Chỉ có hiệu lực trong Vite dev server; không xuất hiện trong build hoặc preview.
# Khai báo trong frontendV2/.env.local (đã được .gitignore).
#
# QNU_DEV_AUTO_LOGIN=true
# QNU_DEV_ACCESS_KEY=QNU@2026
# QNU_DEV_WORKSPACE_CODE=shl
# VITE_DEV_WORKSPACE_CODE=shl

# --- Cổng trợ lý công khai trên trang chủ ---
# Slug của trợ lý đã bật xuất bản (tab Công khai) để nút "Hỏi ngay" mở
# /chatbot/{slug} mà không bắt đăng nhập. Để trống khi chưa có trợ lý công
# khai; khi trống, trang chủ giữ nguyên luồng đăng nhập nội bộ hiện tại.
#
# VITE_PUBLIC_CHATBOT_SLUG=tuyen-sinh-2026

# --- Đăng nhập QNU SSO (OpenID Connect + PKCE) ---
# Build production mặc định BẬT SSO: authority https://sso.qnu.edu.vn, client
# qnu-ai-web. Chỉ đặt VITE_SSO_ENABLED=false khi thật sự cần tắt.
# Vite dev mặc định TẮT SSO để giữ bridge dev hiện tại; muốn thử SSO trong dev
# thì khai báo trong frontendV2/.env.local (đã được .gitignore):
#
# VITE_SSO_ENABLED=true
# VITE_SSO_AUTHORITY=https://localhost:7067
# VITE_SSO_CLIENT_ID=qnu-ai-web
# VITE_SSO_SCOPE=openid profile email roles offline_access ai_api
#
# qnu-sso đã đăng ký redirect URI http://localhost:3002/signin-oidc, nên khi
# thử SSO trong dev hãy mở http://localhost:3002 (không dùng 127.0.0.1).
# Máy chủ SSO dev dùng chứng chỉ tự ký: mở trước https://localhost:7067 một lần
# để chấp nhận chứng chỉ, nếu không trình duyệt sẽ chặn luồng chuyển hướng.

